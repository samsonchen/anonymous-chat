# 這個檔案只是範本，可以 commit。真正的設定放在 .env.local（不會被 commit）。
# 絕對不要把真實的金鑰寫進這個檔案。

# 聊天服務：
#   mock     = 階段一的模擬版，訊息只存在自己的瀏覽器（預設）
#   supabase = 階段二，接上 Supabase
VITE_CHAT_BACKEND=mock

# 階段二才需要。只放 Project URL 和 publishable key（sb_publishable_...）。
# 絕對不要放 sb_secret_... 或 service_role。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
